    "/api/health": {
      "get": {
        "summary": "Liveness, or full status with a token",
        "operationId": "get_api_health",
        "tags": [
          "handlers"
        ],
        "responses": {
          "200": {
            "description": "Anonymous: {\"status\":\"ok\"}. With a token: the full status document.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/HealthAnonymous"
                    },
                    {
                      "$ref": "#/components/schemas/HealthFull"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Daemon unreachable: {\"status\":\"degraded\"}, or the full document with status \"degraded\" for a token holder.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/HealthAnonymous"
                    },
                    {
                      "$ref": "#/components/schemas/HealthFull"
                    }
                  ]
                }
              }
            }
          }
        },
        "description": "Public. Without a valid bearer token the body is only {\"status\":\"ok\"} (200) or {\"status\":\"degraded\"} (503). With a valid owner token it is the full status document.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
