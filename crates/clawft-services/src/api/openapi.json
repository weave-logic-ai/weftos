  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Daemon-issued owner token (wft_...). Project tokens are refused."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, unknown, expired, revoked or non-owner token",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "DaemonUnavailable": {
        "description": "The daemon that owns tokens is unreachable",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                },
                "remedy": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "HealthAnonymous": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok",
              "degraded"
            ]
          }
        },
        "additionalProperties": false
      },
      "HealthFull": {
        "type": "object",
        "required": [
          "status",
          "version",
          "uptime_secs",
          "build",
          "gateway",
          "daemon",
          "kernel",
          "chain",
          "mcp",
          "channels",
          "providers",
          "token"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "uptime_secs": {
            "type": "integer"
          },
          "build": {
            "type": "object"
          },
          "gateway": {
            "type": "object"
          },
          "daemon": {
            "type": "object"
          },
          "kernel": {
            "type": [
              "object",
              "null"
            ]
          },
          "chain": {
            "type": [
              "object",
              "null"
            ]
          },
          "mcp": {
            "type": "object"
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "configured": {
                  "type": "boolean"
                }
              }
            }
          },
          "token": {
            "type": "object"
          }
        }
      },
      "JsonRpcRequest": {
        "type": "object",
        "required": [
          "jsonrpc",
          "method"
        ],
        "properties": {
          "jsonrpc": {
            "const": "2.0"
          },
          "id": {},
          "method": {
            "type": "string"
          },
          "params": {}
        }
      }
    }
  }
}
