        "summary": "Mint a short-lived read-only token for one project from a tailnet identity",
        "operationId": "post_api_console_token",
        "tags": [
          "console"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project"
                ],
                "properties": {
                  "project": {
                    "type": "string",
                    "description": "Project ULID"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{token, expires_at, project}"
          },
          "400": {
            "description": "Bad body"
          },
          "403": {
            "description": "Not a tailnet peer, login not allowlisted, or cross-origin"
          },
          "404": {
            "description": "Unknown project, or tailnet identity is not enabled"
          },
          "503": {
            "description": "whois or daemon unavailable"
          }
        },
        "description": "Disabled (404) unless gateway.tailnetIdentity.enabled. No bearer: the caller is identified by its TCP peer address and tailscale whois."
      }
    },
