{
  "name": "weftos",
  "private": true,
  "description": "WeftOS / clawft monorepo — Rust agent operating system (kernel, mesh, governance) with optional Node tooling for Ruflo/MetaHarness orchestration",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/weave-logic-ai/weftos.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bash scripts/build.sh native-debug",
    "test": "bash scripts/build.sh test",
    "check": "bash scripts/build.sh check",
    "clippy": "bash scripts/build.sh clippy",
    "gate": "bash scripts/build.sh gate",
    "metaharness:score": "bash scripts/metaharness/score.sh",
    "metaharness:foundation": "bash scripts/metaharness/weftos-score.sh",
    "metaharness:eval": "bash scripts/metaharness/flywheel-score-eval.sh",
    "metaharness:gate": "bash scripts/metaharness/run-task.sh gate",
    "metaharness:views": "bash scripts/metaharness/validate-views.sh",
    "metaharness:genome": "npx --yes metaharness genome . --json",
    "metaharness:flywheel": "node scripts/metaharness/flywheel-measure.mjs",
    "metaharness:flywheel:measure": "node scripts/metaharness/flywheel-measure.mjs measure",
    "metaharness:flywheel:smoke": "node scripts/metaharness/flywheel-measure.mjs smoke",
    "metaharness:flywheel:status": "node scripts/metaharness/flywheel-measure.mjs status",
    "metaharness:brain:index": "node scripts/metaharness/weftos-brain.mjs index",
    "metaharness:brain:search": "node scripts/metaharness/weftos-brain.mjs search",
    "metaharness:brain:stats": "node scripts/metaharness/weftos-brain.mjs stats",
    "metaharness:crosscut": "node scripts/metaharness/crosscut.mjs",
    "metaharness:darwin": "node scripts/metaharness/darwin-loop.mjs",
    "metaharness:darwin:confirm": "node scripts/metaharness/darwin-loop.mjs --confirm",
    "metaharness:loop": "node scripts/metaharness/weftos-brain.mjs index && node scripts/metaharness/crosscut.mjs && node scripts/metaharness/darwin-loop.mjs --measure && node scripts/metaharness/goal-check.mjs",
    "metaharness:loop:until": "node scripts/metaharness/loop-runner.mjs",
    "metaharness:loop:forever": "node scripts/metaharness/loop-runner.mjs --forever --interval 10",
    "metaharness:goal": "node scripts/metaharness/goal-check.mjs"
  },
  "devDependencies": {
    "@claude-flow/cli": "3.42.4",
    "@metaharness/flywheel": "^0.1.10",
    "agentic-flow": "^2.1.0",
    "ruflo": "3.42.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@claude-flow/cli": "3.42.4",
    "protobufjs": "7.6.5",
    "undici": "7.30.0",
    "adm-zip": "0.6.1",
    "sharp": "0.35.5",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "brace-expansion": "5.0.12",
    "fast-uri": "4.2.1",
    "toml": "4.3.0",
    "proxy-addr": "2.0.8"
  },
  "weftos": {
    "rufloPin": "3.42.4",
    "rufloPinNote": "AUTHORITY is ~/dev/ruflo branch feat/grok-host (ADR-320 team_*, init --grok). Grok loads it via .grok/config.toml [mcp_servers.ruflo] → v3/@claude-flow/cli/bin/cli.js. The version string only documents that checkout (3.42.4 after merging ruvnet/main into grok-host 2026-09-19, cf8443898). Do not treat npm ruflo@3.42.4 as a substitute — published packages do not carry team_*. Relink: ~/dev/ruflo/scripts/use-local-ruflo.sh. AgentDB backup: .swarm/backups/2026-09-19-pre-ruflo-3.42.4/. WEFT-684 / WEFT-669: never npx ruflo@latest; never put ~/dev/ruflo in tracked .mcp.json.",
    "primaryLanguage": "rust",
    "product": "agent-operating-system",
    "harness": {
      "foundationScore": "scripts/metaharness/weftos-score.sh",
      "upstreamScorecard": "scripts/metaharness/score.sh",
      "tasks": ".metaharness/tasks",
      "policy": "ADR-096 evaluate→receipt→promote; never silent champion"
    }
  }
}
