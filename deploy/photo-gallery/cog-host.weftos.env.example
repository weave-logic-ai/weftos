# Install as root-owned /etc/weftos/projects/weftos/cog-host.env (mode 0600).
# Allocate a distinct port for every project on this host.
COG_HOST_PORT=9480
# Listen on the tailnet address so the console (served by the gateway) can reach it from a
# browser on another tailnet machine. Omit to stay on 127.0.0.1.
COG_HOST_BIND=100.90.170.87
# Browser origin allowed to call the host API: the console under the gateway.
WEFT_COG_HOST_ORIGINS=http://100.90.170.87:18789
# The host token is generated by weft-cog-host in <root>/host.token (0700 state dir);
# do not put WEFT_COG_HOST_TOKEN in this file.
